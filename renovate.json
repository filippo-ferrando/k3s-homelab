{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/^infrastructure/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^apps/.+\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Group patch and minor updates together to reduce PR clutter",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies"
    },
    {
      "description": "Label and separate infrastructure Helm chart updates",
      "matchFileNames": [
        "infrastructure/**"
      ],
      "labels": ["infrastructure", "renovate"]
    },
    {
      "description": "Label and separate application container image updates",
      "matchFileNames": [
        "apps/**"
      ],
      "labels": ["apps", "renovate"]
    }
  ]
}
