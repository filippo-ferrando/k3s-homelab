{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/^infrastructure/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^apps/.+\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Redirect Forgejo image lookups away from rate-limited Codeberg endpoint",
      "matchPackageNames": [
        "codeberg.org/forgejo/forgejo",
        "codeberg.org/forgejo/forgejo:"
      ],
      "overridePackageName": "data.forgejo.org/forgejo/forgejo"
    },
    {
      "description": "Group patch and minor updates together to reduce PR clutter",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "non-major dependencies"
    },
    {
      "description": "Label and separate infrastructure Helm chart updates",
      "matchFileNames": [
        "infrastructure/**"
      ],
      "labels": [
        "infrastructure",
        "renovate"
      ]
    },
    {
      "description": "Label and separate application container image updates",
      "matchFileNames": [
        "apps/**"
      ],
      "labels": [
        "apps",
        "renovate"
      ]
    }
  ]
}
